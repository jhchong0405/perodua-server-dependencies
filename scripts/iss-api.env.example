# Literal KEY=VALUE only. No shell expansion, inline comments or quote removal.
# For iss-api.sh install --config: copy outside the repository; DB_PASSWORD_FILE is an
# absolute path to a separate file that holds only the database password.
DB_HOST=192.168.1.30
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_USER=api_reader
DB_PASSWORD_FILE=/root/iss-db-password

# 127.0.0.1: only this server (a reverse proxy or an SSH tunnel on it). 0.0.0.0: every
# address; put a firewall in front first, because ufw does not filter ports Docker publishes.
BIND_IP=127.0.0.1
HTTP_PORT=8000
WORKERS=2
PROJECT_NAME=perodua-iss-api

# Optional: the SHA-256 (64 hex digits) of an API key the caller already has.
# Empty: install issues a new key and shows it once.
API_KEY_HASH=
