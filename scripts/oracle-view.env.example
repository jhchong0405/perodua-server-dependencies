# Settings for: sudo bash oracle-view.sh install --config oracle-view.env
# Literal KEY=VALUE lines, never shell code. install reads them over the saved
# settings and saves them in /opt/perodua-oracle-view/oracle-view.env: the first
# four always, the time-outs only with a value. Without settings, these defaults
# apply. The tool's secrets are in its image, not here.

# Limits of the container on the App server (the App runs there too).
# Memory, also the memory with swap: 1g, 768m (at least 256m).
OVB_MEM_LIMIT=1g
# Processes and threads: 32-32768.
OVB_PIDS_LIMIT=256
# CPUs: 0.01-99.99.
OVB_CPUS=1.5

# TLS to the RP database on the DB server. require (default): encrypted, and no
# connection when the DB server has ssl off. prefer: also clear text when ssl is off
# there (owner decision; the rows of the SQL console hold password hashes and keys).
OVB_RP_SSLMODE=require

# Time-outs of the tool, in seconds: 5-3600. Without the key (or with no value,
# which also removes a saved one), the container gets no such variable and the
# default of the image applies: 300. The start lines of sudo docker logs
# oracle-view show the values (Live Oracle: ... and SQL console: ...).
# Each round trip of a live Oracle call of the Oracle view (Rows, Filter, Count
# rows, Check values, Check definition, Look up, Refresh):
# OVB_LIVE_TIMEOUT=300
# One statement of the SQL console:
# OVB_SQL_TIMEOUT=300
