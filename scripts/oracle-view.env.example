# Settings for: sudo bash oracle-view.sh install --config oracle-view.env
# Literal KEY=VALUE lines, never shell code. install reads them over the saved
# settings and saves all four in /opt/perodua-oracle-view/oracle-view.env. Without
# settings, these defaults apply. The tool's secrets are in its image, not here.

# Limits of the container on the App server (the App runs there too).
# Memory, also the memory with swap: 1g, 768m (at least 256m).
OVB_MEM_LIMIT=1g
# Processes and threads: 32-32768.
OVB_PIDS_LIMIT=256
# CPUs: 0.01-99.99.
OVB_CPUS=1.5

# TLS to the RP database on the DB server. require (default): encrypted, and no
# connection when the DB server has ssl off. prefer: also clear text when ssl is off
# there (owner decision; the rows of the SQL console hold password hashes and keys).
OVB_RP_SSLMODE=require
