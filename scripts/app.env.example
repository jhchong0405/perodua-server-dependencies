# Literal KEY=VALUE only. No shell expansion, inline comments or quote removal.
# Copy outside the repository; supply an absolute path to a separate password file.
DB_HOST=192.168.1.20
DB_PORT=5432
DB_NAME=perodua
DB_USER=odoo
DB_PASSWORD_FILE=/root/perodua-db-password

PROJECT_NAME=perodua-client-uiux
HTTP_PORT=8110
BIND_IP=0.0.0.0
STARTUP_TIMEOUT=600
INIT_TIMEOUT=3600

# Optional. PUBLIC_ROOT serves the page under a path, such as /dev (v1.0.4 or
# later); ENVIRONMENT_LABEL is the label on the sign-in page (v1.0.4 or later,
# empty: the release's own); PUBLIC_BASE_URL is the address browsers use. From
# v1.0.5 it is the https:// address of the sign-in host, or the sign-in
# hand-over stays off: https://stgiss.perodua.com.my/dev in the grey
# environment. See docs/DEPLOYMENT.md, "Two environments on one server" and
# "Sign in once on stgiss".
PUBLIC_ROOT=
ENVIRONMENT_LABEL=
PUBLIC_BASE_URL=

# Optional: outgoing email. It needs Client Stable UIUX v1.2.2 or later: the
# scripts folder of v1.2.1 refuses these settings. Empty SMTP_HOST: no outgoing
# email. SMTP_ENCRYPTION is starttls (the default, port 587), ssl (port 465) or
# none (port 25, an internal relay without sign-in). Empty SMTP_USER: no
# sign-in. SMTP_PASSWORD_FILE is the absolute path to a separate file that
# holds only the SMTP password (there is no password setting or option).
# SMTP_FROM is the sender address of every email; SMTP_FROM_NAME its sender
# name (empty: the author's name). MAIL_REDIRECT_TO is one test address that
# gets every email, or off to send each email to its real recipients. See
# docs/DEPLOYMENT.md, "Outgoing email".
SMTP_HOST=
SMTP_PORT=
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASSWORD_FILE=
SMTP_FROM=
SMTP_FROM_NAME=
MAIL_REDIRECT_TO=
