# Settings for: sudo bash rp-adapter.sh install --config rp-adapter.env --non-interactive
# Literal KEY=VALUE lines, never shell code. install saves them (without the two
# *_FILE lines) in /opt/perodua-rp-adapter/rp-adapter.env.

# The Oracle EBS database. An account with SELECT grants only is safest: the
# adapter reads in read-only transactions, but a PL/SQL function with its own
# (autonomous) transaction could still write with a more powerful account.
DB_HOST=10.1.119.26
DB_PORT=1521
DB_SERVICE=ENTPP2
DB_USER=RP_GATEWAY
# A file holding only the database password; read once, stored in secrets/.
DB_PASSWORD_FILE=/root/rp-db-password

# Seconds before any single database call is cut off.
CALL_TIMEOUT=120

# The ISS-Oracle API, when it is used as well (blank: not used). With the
# default DOCKER_NETWORK=host, 127.0.0.1 is this server.
API_URL=
# A file holding only the API key; needed when API_URL is set.
#API_KEY_FILE=/root/iss-api-key

# host (default): the container uses this server's network. Or the name of a
# Docker network that reaches the database.
DOCKER_NETWORK=host
